rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      // 누구나 읽을 수 있습니다.
      allow read: if true;

      // 5글자 이상일 때만 새 메모 작성 및 수정을 허용합니다.
      allow create, update: if request.resource.data.text is string && request.resource.data.text.size() >= 5;

      // 메모 삭제를 허용합니다.
      allow delete: if true;
    }
  }
}
